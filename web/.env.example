# Web Server
PORT=3000
ADMIN_TOKEN=change_this_admin_password

# PostgreSQL (ปล่อยว่างได้หากต้องการรันในโหมด In-Memory/Demo ชั่วคราว)
DATABASE_URL=postgres://nbs:nbs_secret_change_me@127.0.0.1:5432/nbs_smp

# Minecraft Server RCON (ตั้งค่าใน server.properties: enable-rcon=true, rcon.port=25575)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=change_this_rcon_password
RCON_POLL_MS=3000

# AI Game Director (Optional — หากไม่ใส่ ระบบจะใช้ Weighted Pool Fallback อัตโนมัติ)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
