{
  "name": "nbs-smp-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "dev:client": "bunx vite --port 5173",
    "build:client": "bunx vite build",
    "start": "bun run build:client && bun run src/server/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "db:push": "bunx drizzle-kit push",
    "db:generate": "bunx drizzle-kit generate"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/eden": "^1.3.2",
    "@elysiajs/static": "^1.3.0",
    "@google/genai": "^1.0.0",
    "drizzle-orm": "^0.44.0",
    "elysia": "^1.3.1",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
