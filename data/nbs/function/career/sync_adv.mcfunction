# ตรวจแต่ละทีม (1-8) ว่าทีมมีสายอาชีพตรงตาม $(career) และมีสมาชิกปลดล็อก Advancement $(adv) แล้วหรือยัง (นับ 1 ครั้งต่อทีม)
$execute unless data storage nbs:adv done.$(key).t1 if score #t1_career career_id matches $(career) if entity @a[scores={team_id=1},advancements={$(adv)=true}] run function nbs:career/award_team_adv {team:1,key:"$(key)",pts:$(pts),name:"$(name)"}
