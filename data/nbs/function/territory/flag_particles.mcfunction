# ยิง Particle สีประจำทีมรอบเสาธงอาณาเขต
execute if score @s team_id matches 1 run particle minecraft:dust{color:[1.0,0.2,0.2],scale:1.2} ~ ~1.2 ~ 0.6 0.8 0.6 0 4 normal
execute if score @s team_id matches 2 run particle minecraft:dust{color:[0.2,0.5,1.0],scale:1.2} ~ ~1.2 ~ 0.6 0.8 0.6 0 4 normal
execute if score @s team_id matches 3 run particle minecraft:dust{color:[0.2,0.9,0.3],scale:1.2} ~ ~1.2 ~ 0.6 0.8 0.6 0 4 normal
execute if score @s team_id matches 4 run particle minecraft:dust{color:[1.0,0.85,0.1],scale:1.2} ~ ~1.2 ~ 0.6 0.8 0.6 0 4 normal
